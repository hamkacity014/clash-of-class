# ==============================================================================
# CLASH OF CLASS - KONFIGURASI SUPABASE (VERCEL & LOCAL READY)
# ==============================================================================
# Panduan Mendapatkan Kredensial Supabase:
# 1. Buka https://supabase.com dan login / daftar akun gratis.
# 2. Buat Project baru (misal: "clash-of-class").
# 3. Masuk ke Project Settings -> API.
# 4. Salin "Project URL" ke NEXT_PUBLIC_SUPABASE_URL di bawah ini.
# 5. Salin "anon public" Project API Key ke NEXT_PUBLIC_SUPABASE_ANON_KEY di bawah ini.
#
# Catatan: Jika kedua variabel di bawah ini masih kosong, aplikasi akan secara
# otomatis berjalan dalam "Local Demo / In-Memory Mock Mode" sehingga tetap
# bisa diuji coba secara langsung tanpa error!
# ==============================================================================

NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
